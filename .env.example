# Copy to .env (server) and .env.local (frontend)

# Frontend — Google OAuth client ID (Google Cloud Console → Credentials → OAuth client ID → Web)
# Authorized JavaScript origins: http://localhost:5173 and your production domain
VITE_GOOGLE_CLIENT_ID=

# Server
GOOGLE_CLIENT_ID=
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
